# Copy to .streamlit/secrets.toml for local use, or paste the contents into
# Streamlit Community Cloud under  App settings -> Secrets.
# NEVER commit the real secrets.toml - .gitignore already excludes it.

# Shared team password. Omit it and the app is open to anyone with the URL.
app_password = "change-me"

# Supabase project credentials. Omit both to fall back to local JSON files.
# URL:      Supabase dashboard -> Project Settings -> API -> Project URL
# KEY:      the same page -> Project API keys -> service_role
#           (service_role bypasses row-level security. That is intended here:
#            the app is the only client and it is already behind the password
#            gate above. Never ship this key to a browser.)
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_KEY = "eyJ..."
